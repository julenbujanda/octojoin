# Secrets for docker compose. Copy to .env and fill in your values:
#   cp .env.example .env
# .env is git-ignored, so your credentials never get committed.

# Required: your Octopus Energy account ID and API key
# (dashboard → Personal details → API access)
OCTOPUS_ACCOUNT_ID=A-1234ABCD
OCTOPUS_API_KEY=sk_live_...

# Optional: ntfy push notifications (leave empty to disable)
# The URL must include the topic. Anyone who knows the topic can read it, so keep it private.
# Test with: docker compose run --rm octojoin -test-ntfy
NTFY_URL=
NTFY_TOKEN=
